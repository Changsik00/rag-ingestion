# Server
ENV=development
PORT=8000
API_URL=http://localhost:8000

# Database (Neo4j)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password

# Database (ChromaDB)
CHROMA_HOST=localhost
CHROMA_PORT=8001
# CHROMA_DB_PATH=./chroma_data # Optional: If using local persistence

# LLM
GEMINI_API_KEY=your_gemini_api_key_here
FIRECRAWL_API_KEY=your_firecrawl_api_key_here

# Chunking Strategy
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
